# ──────────────────────────────────────── Redis ────────────────────────────────────────
REDIS_URL="Redis connection URL. e.g. redis://localhost:6379"
REDIS_TIMEOUT_SECONDS="Connect/read timeout in seconds, so an unresponsive Redis fails fast instead of hanging. By default it is 5.0"
LOCATION_KEY="Redis key where user locations are stored. e.g. users_location"
RADIUS_ALERT="Radius used to trigger proximity alerts. e.g. 500"
RADIUS_UNITY="Unit for RADIUS_ALERT (M | KM | MI | FT). e.g. M"

# ───────────────────────────────────── Service Bus ─────────────────────────────────────
CONNECTION_STR="Azure Service Bus connection string. e.g. Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
QUEUE_NAME="Name of the queue where notifications are published. e.g. notificaciones"

# ───────────────────────────────────── Development ─────────────────────────────────────
DEBUG="Set to true to enable debug mode (disable in production). By default it is false"